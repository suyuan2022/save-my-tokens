{
  "_说明": "开关清单。只收对着官方文档逐条核过的键。scan 只报当前值和默认值，不替用户选。键名、默认值、版本门槛会变，核对日期超过三个月的条目先重新核对出处再用。",
  "verified": "2026-11-18",
  "claude": [
    {
      "key": "autoCompactWindow",
      "where": "settings",
      "default": "未设（Claude Code 按模型自动选）",
      "what": "上下文用到多少 token 时自动压缩。范围 100000–1000000。环境变量 CLAUDE_CODE_AUTO_COMPACT_WINDOW 会盖过它。",
      "source": "https://code.claude.com/docs/en/settings-reference#autocompactwindow"
    },
    {
      "key": "CLAUDE_CODE_AUTO_COMPACT_WINDOW",
      "where": "env",
      "default": "未设",
      "what": "同上，优先级高于 autoCompactWindow。带 k 后缀的写法（如 350k）要 v2.1.304 以上，纯数字都认。",
      "source": "https://code.claude.com/docs/en/env-vars"
    },
    {
      "key": "idleCompaction",
      "where": "settings",
      "default": "未设（开）",
      "what": "长会话放着不动、缓存快过期时，在后台先压缩一次。关掉后会话不会被自动压，但隔很久回来的第一条消息要重建整段缓存。",
      "source": "https://code.claude.com/docs/en/settings-reference#idlecompaction"
    },
    {
      "key": "promptSuggestionEnabled",
      "where": "settings",
      "default": "true",
      "what": "输入框里灰色的下一句预测。每轮结束后多一次请求来生成它。",
      "source": "https://code.claude.com/docs/en/settings-reference#promptsuggestionenabled"
    },
    {
      "key": "awaySummaryEnabled",
      "where": "settings",
      "default": "未设（开）",
      "what": "离开几分钟回来时显示一行会话回顾。",
      "source": "https://code.claude.com/docs/en/settings-reference#awaysummaryenabled"
    },
    {
      "key": "crossSessionInbound",
      "where": "settings",
      "default": "未设（按消息逐条决定）",
      "what": "别的 Claude Code 会话发来的消息怎么处理：accept 送给模型 / hold 只提示 / refuse 丢掉。用 agent team 或多窗口协作的人需要 accept。",
      "source": "https://code.claude.com/docs/en/settings-reference#crosssessioninbound"
    },
    {
      "key": "includeGitInstructions",
      "where": "settings",
      "default": "true",
      "what": "Bash 工具说明里自带的 commit / PR 写法，加上会话开始时的 git status 快照。自己有 git 流程的 skill 时可以设 false 把这两样都去掉。",
      "source": "https://code.claude.com/docs/en/settings-reference#includegitinstructions"
    },
    {
      "key": "bashOutputMaxChars",
      "where": "settings",
      "default": "未设（30000 字符）",
      "what": "一条成功的 Bash 命令最多有多少字符的输出直接进上下文，超出的存成文件、只给预览和路径。取值会被夹到 4000–128000。要 v2.1.261 以上。",
      "source": "https://code.claude.com/docs/en/settings-reference#bashoutputmaxchars"
    },
    {
      "key": "disableClaudeAiConnectors",
      "where": "settings",
      "default": "false（会拉取）",
      "what": "要不要把 claude.ai 账号里连过的 MCP 连接器带进终端会话。环境变量 ENABLE_CLAUDEAI_MCP_SERVERS=false 效果相同。",
      "source": "https://code.claude.com/docs/en/settings-reference#disableclaudeaiconnectors"
    },
    {
      "key": "ENABLE_CLAUDEAI_MCP_SERVERS",
      "where": "env",
      "default": "未设",
      "what": "设成 false 时不拉取 claude.ai 的 MCP 连接器。",
      "source": "https://code.claude.com/docs/en/env-vars"
    },
    {
      "key": "disableBundledSkills",
      "where": "settings",
      "default": "未设（内置 skill 都加载）",
      "what": "关掉 Claude Code 自带的全部 skill。打开后 /doctor prompt-audit 也用不了。只想关个别的用 skillOverrides。",
      "source": "https://code.claude.com/docs/en/settings-reference#disablebundledskills"
    },
    {
      "key": "ENABLE_TOOL_SEARCH",
      "where": "env",
      "default": "未设（MCP 工具延迟加载）",
      "what": "未设或 true 时，MCP 工具的说明不常驻，用到才搜出来加载。false 时所有 MCP 工具说明每轮都在上下文里。",
      "source": "https://code.claude.com/docs/en/env-vars"
    },
    {
      "key": "MAX_MCP_OUTPUT_TOKENS",
      "where": "env",
      "default": "未设（25000）",
      "what": "一次 MCP 工具返回最多多少 token。",
      "source": "https://code.claude.com/docs/en/env-vars"
    },
    {
      "key": "disableAutoMode",
      "where": "settings",
      "default": "未设",
      "what": "把 auto 模式从 Shift+Tab 的切换里拿掉。类型是字符串 \"disable\"，不是布尔值。",
      "source": "https://code.claude.com/docs/en/settings-reference#disableautomode"
    }
  ],
  "codex": [
    {
      "key": "model_auto_compact_token_limit",
      "default": "未设（Codex 按模型决定）",
      "what": "对话历史用到多少 token 时自动压缩。",
      "source": "https://developers.openai.com/codex/config-schema.json"
    },
    {
      "key": "model_post_turn_compact_threshold_percent",
      "default": "未设（不做回合末压缩）",
      "what": "可用窗口用到百分之多少时，等这一轮回答完再压缩。0 或不写表示关，取值 0–100。",
      "source": "https://developers.openai.com/codex/config-schema.json"
    },
    {
      "key": "tool_output_token_limit",
      "default": "未设",
      "what": "一次工具输出存进上下文时的 token 预算。",
      "source": "https://developers.openai.com/codex/config-schema.json"
    },
    {
      "key": "model_context_window",
      "default": "未设（用模型自带的窗口）",
      "what": "手动指定模型上下文窗口大小。写了就是覆盖了默认值。",
      "source": "https://developers.openai.com/codex/config-schema.json"
    },
    {
      "key": "project_doc_max_bytes",
      "default": "32768",
      "what": "项目指令文件（各级 AGENTS.md）合计最多读多少字节，超出的部分读不到。",
      "source": "https://developers.openai.com/codex/config-schema.json"
    },
    {
      "key": "model_reasoning_effort",
      "default": "未设（模型默认档）",
      "what": "日常推理档位。",
      "source": "https://developers.openai.com/codex/config-schema.json"
    },
    {
      "key": "plan_mode_reasoning_effort",
      "default": "未设",
      "what": "Plan 模式单独用的推理档位。",
      "source": "https://developers.openai.com/codex/config-schema.json"
    },
    {
      "key": "service_tier",
      "default": "未设",
      "what": "请求走哪个服务档（default / priority / flex，旧写法 fast 也认）。加速档怎么计费以 OpenAI 官方说明为准。",
      "source": "https://developers.openai.com/codex/config-schema.json"
    },
    {
      "key": "web_search",
      "default": "未设",
      "what": "联网搜索工具的模式：disabled / cached / indexed / live。",
      "source": "https://developers.openai.com/codex/config-schema.json"
    }
  ]
}
